{
  "name": "pure-strike-golf",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Browser golf with real ball-flight physics and strokes-gained stats",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "calibrate": "node tools/calibrate.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "vendor": "node tools/vendor.mjs",
    "vendor:check": "node tools/vendor.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "three": "0.169.0"
  }
}
